{
  "manifest_version": 3,
  "name": "Sky Switch",
  "version": "1.0",
  "description": "Toggle the 'sky' light on Google Home from any tab.",
  "action": {
    "default_title": "Toggle sky light"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["scripting", "tabs"],
  "host_permissions": ["https://home.google.com/*"],
  "commands": {
    "toggle-sky": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Toggle the sky light"
    }
  }
}
